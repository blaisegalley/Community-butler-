# Copy to .env and fill in. Never commit the real .env file.

# Required — generateCaptionDrafts (Part 2)
ANTHROPIC_API_KEY=
# Model id. Defaults to claude-sonnet-5 if unset — update as newer models ship.
ANTHROPIC_MODEL=claude-sonnet-5

# Required for publishToMeta (Part 4) — see README.md "Meta setup prerequisites"
# before expecting these to work. Long-lived Page access token with
# pages_manage_posts + instagram_content_publish granted.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Optional — weather-triggered snow-shoveling drafts (Part 5)
OPENWEATHER_API_KEY=
# Barrington, IL, US by default.
WEATHER_LAT=42.1531
WEATHER_LON=-88.1342
# Millimeters of snow forecast within 48h that trips the trigger.
SNOW_THRESHOLD_MM=20

# CORS — the admin dashboard origin(s) allowed to call this API, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

PORT=8787
