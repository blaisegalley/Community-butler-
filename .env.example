# Copy to .env.local for local development. .env.local is gitignored.
#
# Every value here is safe to publish — they ship inside the built app.
# The secrets that matter (the Supabase service role key, the VAPID
# private key, the Resend API key) live only in Supabase's Edge Function
# secrets and never appear in this repository or in a build.
#
# Leave these blank and the app falls back to localStorage: it works, but
# nothing is shared between devices and no notifications or emails are
# sent.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# From: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=

# Only used by the localStorage fallback, for the demo admin login.
VITE_LOCAL_ADMIN_EMAIL=
VITE_LOCAL_ADMIN_PASSWORD=
